{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/getdone/bootstrap-manifest.schema.json",
  "title": "Bootstrap profile manifest",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "description"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^skill/bootstrap/templates/[a-z0-9-]+$"
          },
          "extends": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "source"
            ]
          },
          {
            "required": [
              "extends"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
